Array buffer->20;
Array parse->20;
Array ustack --> 5;
Array mouse --> 4;
Array picinfo --> 2;

! A formatted table for print_form: each line is a word holding the character
! count followed by that many character bytes; a zero word ends the table.
Array formtable ->
    0 5 'h' 'e' 'l' 'l' 'o'
    0 3 'y' 'o' 'u'
    0 0;

! Shogun measures its menu strings by printing them to stream 3 and reading
! the width the interpreter must leave in header word $30 (z-spec 7.1.2.1.1).
Array s3tab -> 66;

Global fw = 1;      ! how many units a character cell is wide...
Global fh = 1;      ! ...and tall, from get_wind_prop 13 (z-spec 8.8.3.2.5)

! A v6 interpreter may count in character cells or in pixels - the spec lets it
! choose, and Ozmoo does both depending on Z6_PIXEL_UNITS. Everything below
! works in CELLS and converts at the opcode boundary with these, so the test
! lays out and prints the same either way. That is also what a portable game
! has to do; getting it wrong is the whole reason for the pixel refactor.
[ ux c; return (c - 1) * fw + 1; ];   ! 1-based cell column -> 1-based units
[ uy r; return (r - 1) * fh + 1; ];   ! 1-based cell row    -> 1-based units
[ cw n; return n * fw; ];             ! a WIDTH or count in cells -> units
[ ch n; return n * fh; ];
[ toc n; return n / fw; ];            ! a width in units -> cells
[ tor n; return n / fh; ];

[main w h ww hh dx dy result;
#iftrue (#version_number == 6);
	@get_wind_prop 0 13 -> result;   ! height in the high byte, width in the low
	fh = result / 256;
	fw = result % 256;
	if (fw == 0) fw = 1;             ! never zero: Arthur divides by it
	if (fh == 0) fh = 1;
	print "font ", fw, "x", fh, " units a cell^";
	! --- user stack: push_stack / pop_stack ---
	ustack-->0 = 4; ! four free slots
	@push_stack 111 ustack ?push1ok;
	print "push_stack 1 failed^"; jump pushdone;
.push1ok;
	@push_stack 222 ustack ?push2ok;
	print "push_stack 2 failed^"; jump pushdone;
.push2ok;
	print "pushed, free=", ustack-->0, " top=", ustack-->4, "^";
	@pop_stack 1 ustack;
	print "popped, free=", ustack-->0, "^";
.pushdone;
	ustack-->0 = 0; ! no free slots: the push must fail
	@push_stack 333 ustack ?pushbad;
	print "full stack rejected^"; jump fulldone;
.pushbad;
	print "ERROR: pushed onto a full stack^";
.fulldone;

	! --- game stack: pop_stack without a user stack ---
	@push 42; @push 43; @push 44;
	@pop_stack 2;
	@pull w;
	print "game stack pop -> ", w, " (expect 42)^";

	! --- read_mouse ---
	@read_mouse mouse;
	print "mouse ", mouse-->0, ",", mouse-->1, " buttons ", mouse-->2, "^";

	! --- set_margins / get_wind_prop ---
	w = cw(2); h = cw(3);
	@set_margins w h 0;
	@get_wind_prop 0 6 -> w; ! prop 6 is left margin
	@get_wind_prop 0 7 -> h; ! prop 7 is right margin
	print "margins ", toc(w), ",", toc(h), "^";

	@erase_window (-1);

	! Lay the windows out in CELLS and convert, so the result is the same in
	! either unit system. Dividing the reported UNITS instead would not be:
	! 25 rows / 10 is two cells, but 200 pixel rows / 10 is two and a half.
	w = $21->0;         ! columns
	h = $20->0;         ! rows
	ww = cw(w / 3);
	hh = ch(h / 3);
	@set_colour 11 4 0;
	@window_size 0 hh ww;
	dx = ux(w / 10);
	dy = uy(h / 10);
	@move_window 0 dy dx;
	@set_window 0;
	@erase_window 0;
	print "size (chars) ", $21->0, "  x ", $20->0, "^";
	print "size (cells) ", toc($22-->0), " x ", tor($24-->0), "^";
	print "this is a long text that needs to be wrapped^";
	@window_style 1 3 1; ! set buffering
	@set_colour 8 7 1;
	@window_size 1 hh ww;
	@move_window 1 hh ww;
	@set_window 1;
	@get_wind_prop 1 3 -> h; ! prop 3 is x_size
	print ": ", toc(h), "^";

	@erase_window 1;
	print "this is another long text that needs to be wrapped^";

	! --- window_style with two operands: the operation defaults to 0 (set).
	! Journey styles window 0 this way right after window_size, whose third
	! operand was still in the operand array; reading it as the operation
	! xor'ed every attribute off and Journey's intro stopped wrapping.
	@window_size 1 hh ww;
	@window_style 1 15;
	print "a bare window_style must keep wrapping^";

	! --- erase_line with a pixel count erases value-1 units and leaves the
	! cursor where it was: Journey repaints its command cells this way
	print "0123456789";
	@get_cursor mouse; ! reuse the array: word 0 is the row
	w = mouse-->0;
	dx = ux(3);
	@set_cursor w dx;
	dx = cw(4) + 1;   ! erase_line erases value-1 units: four cells' worth
	@erase_line dx;   ! 2345 go, 6789 stay
	print "ab^"; ! ...and lands right after the cursor: 01ab  6789

	! --- the newline interrupt (8.8.3.2.2): property 9 counts new-lines and
	! property 8 is called when it hits zero - Zork Zero rolls its text
	! around the drop-cap initials this way, releasing the margins from the
	! routine. Two newlines at margin 4, then NLRelease frees the margin.
	@put_wind_prop 1 8 NLRelease;
	@get_wind_prop 1 8 -> w; ! the routine address is a word: must read back
	if (w == NLRelease) print "nl prop ok^"; else print "nl prop BAD^";
	dx = cw(4);
	@set_margins dx 0 1;
	@put_wind_prop 1 9 2;
	print "aa^bb^cc^";
	@set_margins 0 0 1; ! (already released; must be a no-op)

	! --- print_form ---
	print "print_form:^";
	@print_form formtable;

	! --- output_stream 3: the text width lands in header $30 ---
	@output_stream 3 s3tab;
	print "RESTORE a saved game";
	@output_stream (-3);
	print "s3 width ", $30-->0, " len ", s3tab-->0, "^";
	@output_stream 3 s3tab;
	print "abc^ABCDE";   ! two lines: the widest one is the answer
	@output_stream (-3);
	print "s3 width2 ", $30-->0, "^";

	! --- output_stream 3 with a width operand: the table then gets the
	! print_form format, word-wrapped to the width -- Arthur buffers its
	! parser errors this way ("I beg your pardon?") and print_forms them
	@output_stream 3 s3tab (-10);
	print "I beg your pardon?";
	@output_stream (-3);
	w = s3tab-->0;
	h = (s3tab + 2 + w)-->0;
	print "form recs ", w, " ", h, " end ", (s3tab + 4 + w + h)-->0, "^";
	@print_form s3tab;
	! an embedded newline ends a record too; width 0 wraps at window 0
	@output_stream 3 s3tab 0;
	print "ab^cd";
	@output_stream (-3);
	w = s3tab-->0;
	print "form nl ", w, " ", (s3tab + 2 + w)-->0, "^";

	! --- picture_data: no pictures, so nothing is valid and 0 reports none ---
	picinfo-->0 = 99; picinfo-->1 = 99;
	@picture_data 0 picinfo ?pic0valid;
	print "pics ", picinfo-->0, " rel ", picinfo-->1, "^";
	jump picdone;
.pic0valid;
	print "ERROR: picture 0 reported valid^";
.picdone;
	@picture_data 7 picinfo ?pic7valid;
	print "pic 7 absent^";
	jump picdone2;
.pic7valid;
	print "ERROR: picture 7 reported valid^";
.picdone2;

	print "johan^^^";

	! --- scroll_window: backwards, then forwards again ---
	! The window's bottom line is blank here, so scrolling down and then up
	! must put every line back exactly where it was: the blank line the first
	! scroll writes in at the top is carried off again by the second.
	dy = ch(1);
	result = -dy;      ! the operand must be a variable: Inform will not negate
	@scroll_window 1 result;
	@scroll_window 1 dy;

	! --- draw_picture / erase_picture: a note, not a picture ---
	! Last, so that nothing scrolls the notes away. 4 goes to the window's
	! top left corner, 9 is drawn there and erased again, and 12 lands at
	! the cursor, which draw_picture must leave where it found it.
	dy = uy(2); dx = ux(1);
	@draw_picture 9 dy dx;
	@erase_picture 9 dy dx;
	! picture 4 goes in window 0: a window holds at most one picture, and its
	! palette bank is the window's, so two pictures in one window share colours
	@set_window 0;
	dy = uy(1); dx = ux(1);
	@draw_picture 4 dy dx;
	! ...and again at an odd column. On the X16 a tile spans two text columns,
	! so this one cannot sit on the tile grid and is drawn through boundary
	! tiles - the same path a sub-cell horizontal offset uses. Nothing else we
	! build exercises it without playing a commercial game to a scene.
	dy = uy(5); dx = ux(12);
	@draw_picture 4 dy dx;
	@set_window 1;

	print "> ";
	@draw_picture 12;
	buffer->0 = 10;
	buffer->1 = 0;
	parse->1 = 0;
#IfV5;
	@aread buffer parse -> result;
#IfNot;
	@sread buffer parse;
#EndIf;
#endif;
	print "done!^";
];

#iftrue (#version_number == 6);
[ NLRelease;
	! the newline interrupt: free window 1's margins (must not print)
	@set_margins 0 0 1;
];
#endif;

